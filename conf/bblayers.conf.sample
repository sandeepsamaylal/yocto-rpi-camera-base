LCONF_VERSION = "8"

# Submodule-first layout under this repository.
# <REPO_DIR> is replaced by scripts/build.sh when creating conf/bblayers.conf.
BBLAYERS ?= " \
	<REPO_DIR>/sources/poky/meta \
	<REPO_DIR>/sources/poky/meta-poky \
	<REPO_DIR>/sources/poky/meta-yocto-bsp \
	<REPO_DIR>/sources/meta-openembedded/meta-oe \
	<REPO_DIR>/sources/meta-openembedded/meta-python \
	<REPO_DIR>/sources/meta-openembedded/meta-networking \
	<REPO_DIR>/sources/meta-raspberrypi \
	<REPO_DIR>/meta-rpi-camera \
"