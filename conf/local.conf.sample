MACHINE ??= "raspberrypi4-64"
DISTRO ?= "poky"
PACKAGE_CLASSES ?= "package_rpm"

# Keep milestone-1 image simple and accessible for bring-up.
EXTRA_IMAGE_FEATURES ?= "debug-tweaks ssh-server-openssh"

# Build output format that is convenient for SD card flashing.
IMAGE_FSTYPES += "wic.bz2"

# Shared caches reduce rebuild time, especially in containerized builds.
DL_DIR ?= "${TOPDIR}/../cache/downloads"
SSTATE_DIR ?= "${TOPDIR}/../cache/sstate-cache"

# Required by meta-raspberrypi firmware package selection on raspberrypi4-64.
LICENSE_FLAGS_ACCEPTED += "synaptics-killswitch"

# Camera packagegroup is enabled by default for this project.
# Set to "0" to build a smaller base-only image.
RPI_CAMERA_SUPPORT ?= "1"

# Enable Raspberry Pi camera support in firmware config generation.
# VIDEO_CAMERA enables start_x=1 and RASPBERRYPI_CAMERA_V2 selects the IMX219 overlay.
VIDEO_CAMERA = "1"
RASPBERRYPI_CAMERA_V2 = "1"

# Optional application package from rpi-camera-rtsp-mqtt-app repository.
# Set to "1" after the app repository contains buildable sources.
RPI_CAMERA_APP ?= "1"

# Optional source revision override for the camera application recipe.
# Set to a full git commit hash for reproducible builds when RPI_CAMERA_APP = "1".
RPI_CAMERA_APP_SRCREV ?= "bf62702b0b50da96ecd6ce92a9ff6b3a1b561b45"

# Enable GStreamer RTSP runtime packages for streaming integration.
# Set to "0" to keep the image smaller while developing non-RTSP milestones.
RPI_RTSP_SUPPORT ?= "1"

# Enable MQTT runtime packages (broker, CLI tools, and client libraries).
# Set to "0" to disable MQTT-related packages.
RPI_MQTT_SUPPORT ?= "1"

USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
CONF_VERSION = "2"