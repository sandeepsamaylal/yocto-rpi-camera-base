# Runtime defaults for rpi-camera-rtsp-mqtt-app systemd service
# Set RTSP_HOST to the Raspberry Pi IP or hostname clients should use.

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_BASE_TOPIC=camera/pi4-01
RTSP_HOST=127.0.0.1
RTSP_PORT=8554
RTSP_PATH=/camera
WIDTH=1280
HEIGHT=720
FRAMERATE=25
BITRATE=2000000
INTRA_PERIOD=15
