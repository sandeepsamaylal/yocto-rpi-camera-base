#!/bin/sh
### BEGIN INIT INFO
# Provides:          rpi-camera-rtsp-mqtt-app
# Required-Start:    $remote_fs $network mosquitto
# Required-Stop:     $remote_fs $network mosquitto
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Raspberry Pi camera MQTT control app
### END INIT INFO

PIDFILE=/var/run/rpi-camera-rtsp-mqtt-app.pid
DAEMON=/usr/bin/rpi-camera-rtsp-mqtt-app-launcher

start() {
    echo "Starting rpi-camera-rtsp-mqtt-app"
    start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
}

stop() {
    echo "Stopping rpi-camera-rtsp-mqtt-app"
    start-stop-daemon -K -p "$PIDFILE" -x "$DAEMON" || true
    rm -f "$PIDFILE"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "rpi-camera-rtsp-mqtt-app is running"
            exit 0
        fi
        echo "rpi-camera-rtsp-mqtt-app is not running"
        exit 1
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
