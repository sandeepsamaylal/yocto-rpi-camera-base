#!/bin/sh
### BEGIN INIT INFO
# Provides:          rpi-camera-rtsp-relay
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: RTSP relay for camera stream
### END INIT INFO

PIDFILE=/var/run/rpi-camera-rtsp-relay.pid
DAEMON=/usr/bin/rpi-camera-rtsp-relay
DEFAULTS=/etc/default/rpi-camera-rtsp-relay

start() {
    echo "Starting rpi-camera-rtsp-relay"
    if [ -f "$DEFAULTS" ]; then
        set -a
        . "$DEFAULTS"
        set +a
    fi
    start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
}

stop() {
    echo "Stopping rpi-camera-rtsp-relay"
    start-stop-daemon -K -p "$PIDFILE" -x "$DAEMON" || true
    rm -f "$PIDFILE"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "rpi-camera-rtsp-relay is running"
            exit 0
        fi
        echo "rpi-camera-rtsp-relay is not running"
        exit 1
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
